
{
  "version": 2,

  "functions": {
    "api/index.js": {
      "includeFiles": [
        "backend/data/enquiry sheet  old.xlsx",
        "backend/src/**"
      ]
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

